# =============================================================================
# Environment Variables for ReLINE Application
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control!
#
# NOTE: LINE Messaging API の資格情報や seed 用の初期データは環境変数ではなく
#       Rails の暗号化 credentials（bin/rails credentials:edit）で管理します。
#       必要なキーは README.md の「環境変数と資格情報を設定」を参照してください。
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (config/database.yml)
# -----------------------------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# データベース名は development / test では固定（reline_development / reline_test）です。
# DB_NAME は production のみ有効（デフォルト: reline_production）。
# DB_NAME=reline_production

# 接続プールのサイズ（デフォルト: 5）
# RAILS_MAX_THREADS=5

# 接続文字列で一括指定する場合（CI ではこちらを使用）
# DATABASE_URL=mysql2://root:password@127.0.0.1:3306/reline_test

# -----------------------------------------------------------------------------
# Rails / Puma Configuration
# -----------------------------------------------------------------------------
RAILS_ENV=development
PORT=3000

# 本番でログを標準出力に流す場合に設定（config/environments/production.rb）
# RAILS_LOG_TO_STDOUT=true

# 本番で public/ 配下を Rails から配信する場合に設定
# RAILS_SERVE_STATIC_FILES=true

# credentials を復号するマスターキー（production で config/master.key を置かない場合）
# RAILS_MASTER_KEY=your_master_key

# Puma の PID ファイルパス（デフォルト: tmp/pids/server.pid）
# PIDFILE=tmp/pids/server.pid

# -----------------------------------------------------------------------------
# Operator Lock Settings (app/models/operator.rb)
# -----------------------------------------------------------------------------
# ログイン失敗の許容回数（デフォルト: 5）
OPERATOR_LOCK_RETRY_LIMIT=5
# アカウントロックの継続時間（分・デフォルト: 45）
OPERATOR_LOCK_DURATION=45

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# GET /metrics は production でのみ Basic 認証を要求します。
# 未設定の場合、production では 403 を返します。
# MONITOR_USERNAME=metrics
# MONITOR_PASSWORD=your_metrics_password

# -----------------------------------------------------------------------------
# Action Cable (config/cable.yml)
# -----------------------------------------------------------------------------
# production の Action Cable アダプタ用（デフォルト: redis://localhost:6379/1）
# REDIS_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# 例外のバックトレースを省略せず表示する
# BACKTRACE=1
